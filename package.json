{
  "name": "factory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test --pass-with-no-tests ./packages ./apps ./scripts",
    "check": "tsc --noEmit && bun run --cwd apps/andon-ui check",
    "cli:link": "cd packages/cli && bun link",
    "andon": "bun run --cwd apps/andon dev",
    "andon:build": "bun run andon:ui:build && bun run --cwd apps/andon build",
    "andon:ui:build": "bun run --cwd apps/andon-ui build",
    "andon:ui:dev": "bun run --cwd apps/andon-ui dev",
    "factory:event": "bun factory/cli.ts event",
    "release": "bun scripts/release.ts",
    "release:push": "bun scripts/release-push.ts",
    "promote": "bun scripts/promote.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
