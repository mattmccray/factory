{
  "name": "factory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test --pass-with-no-tests ./packages ./apps",
    "check": "tsc --noEmit && bun run --cwd apps/andon check",
    "factory": "bun factory/serve.ts",
    "andon": "bun packages/andon-agent/src/main.ts",
    "andon:build": "bun run --cwd apps/andon build",
    "andon:dev": "bun run --cwd apps/andon dev",
    "factory:event": "bun factory/cli.ts event",
    "factory:test": "bun test factory/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
